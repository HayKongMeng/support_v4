{
    "name": "support/ticketing-system",
    "description": "Modern AI-powered ticketing system with Email and Telegram integration",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "phpmailer/phpmailer": "^6.8",
        "vlucas/phpdotenv": "^5.5",
        "firebase/php-jwt": "^6.8",
        "minishlink/web-push": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
