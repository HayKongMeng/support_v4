# Application
APP_NAME="Support Desk"
APP_URL=http://localhost/support
APP_DEBUG=true

# Database (WAMP default settings)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=support_tickets
DB_USERNAME=root
DB_PASSWORD=

# JWT Secret (generate a random string)
JWT_SECRET=change-this-to-a-random-secret-key-in-production

# OpenAI API (for AI categorization - optional)
OPENAI_API_KEY=

# Default SMTP Settings (can be overridden per company)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Telegram (default bot - companies can have their own)
TELEGRAM_BOT_TOKEN=
