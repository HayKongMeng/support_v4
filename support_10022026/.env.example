# Application
APP_NAME="Support Desk"
APP_URL=http://localhost/support
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=support_tickets
DB_USERNAME=root
DB_PASSWORD=

# JWT Secret (generate a random string)
JWT_SECRET=your-secret-key-here-change-in-production

# OpenAI API (for AI categorization)
OPENAI_API_KEY=sk-your-openai-api-key

# Default SMTP Settings (can be overridden per company)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Telegram (default bot - companies can have their own)
TELEGRAM_BOT_TOKEN=
